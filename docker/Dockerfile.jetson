# NVIDIA JetPack L4T Base Container for Jetson Nano / Xavier / Orin
FROM --platform=linux/arm64 nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir ultralytics opencv-python-headless pyyaml psutil tqdm

COPY . .

CMD ["python", "scripts/run_benchmark.py", "--target", "jetson"]
